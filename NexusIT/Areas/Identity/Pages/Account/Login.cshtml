@page
@model LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login - NexusIT</title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body class="nexus-auth-page">

    <div class="auth-background">

        <div class="auth-glow auth-glow-one"></div>

        <div class="auth-glow auth-glow-two"></div>

    </div>


    <main class="auth-wrapper">

        <div class="auth-brand">

            <div class="auth-brand-logo">
                N
            </div>

            <div class="auth-brand-name">
                NEXUSIT
            </div>

            <div class="auth-brand-subtitle">
                IT MANAGEMENT
            </div>

        </div>


        <section class="auth-card">

            <div class="auth-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <h1>
                Welcome back
            </h1>

            <p class="auth-description">
                Sign in to your IT management dashboard
            </p>


            <form id="account"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="auth-validation"
                     role="alert">
                </div>


                <div class="auth-form-group">

                    <label asp-for="Input.Email">
                        Email Address
                    </label>

                    <input asp-for="Input.Email"
                           class="auth-input"
                           autocomplete="username"
                           placeholder="you@example.com" />

                    <span asp-validation-for="Input.Email"
                          class="auth-validation-message">
                    </span>

                </div>


                <div class="auth-form-group">

                    <label asp-for="Input.Password">
                        Password
                    </label>

                    <input asp-for="Input.Password"
                           class="auth-input"
                           autocomplete="current-password"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Input.Password"
                          class="auth-validation-message">
                    </span>

                </div>


                <div class="auth-remember">

                    <label>

                        <input asp-for="Input.RememberMe" />

                        <span>
                            Remember me
                        </span>

                    </label>

                </div>


                <button id="login-submit"
                        type="submit"
                        class="auth-submit">

                    <i class="bi bi-box-arrow-in-right"></i>

                    Sign In

                </button>


                <div class="auth-divider">

                    <span>
                        Don't have an account?
                    </span>

                </div>


                <a asp-page="./Register"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="auth-secondary-button">

                    Create an account

                </a>

            </form>

        </section>


        <div class="auth-footer">

            <span>
                © @DateTime.Now.Year NexusIT
            </span>

            <span>
                Secure IT Management Platform
            </span>

        </div>

    </main>


    <partial name="_ValidationScriptsPartial" />

</body>

</html>