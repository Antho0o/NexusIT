@model NexusIT.Models.Employee

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="nexus-page">

    <div class="page-header">

        <div>
            <span class="page-eyebrow">NEXUS IT / PEOPLE</span>
            <h1>Edit Employee</h1>
            <p>Update employee information.</p>
        </div>

        <a asp-action="Index"
           class="nexus-btn nexus-btn-secondary">
            ← Back to Employees
        </a>

    </div>

    <div class="nexus-card form-card">

        <form asp-action="Edit">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="form-section">

                <div class="form-section-title">
                    <h2>Personal Information</h2>
                    <p>Update the employee's personal details.</p>
                </div>

                <div class="form-grid">

                    <div class="form-group">

                        <label asp-for="FirstName">
                            First Name
                        </label>

                        <input asp-for="FirstName"
                               class="form-control" />

                        <span asp-validation-for="FirstName"
                              class="validation-message"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="LastName">
                            Last Name
                        </label>

                        <input asp-for="LastName"
                               class="form-control" />

                        <span asp-validation-for="LastName"
                              class="validation-message"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="Email">
                            Email Address
                        </label>

                        <input asp-for="Email"
                               class="form-control" />

                        <span asp-validation-for="Email"
                              class="validation-message"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="PhoneNumber">
                            Phone Number
                        </label>

                        <input asp-for="PhoneNumber"
                               class="form-control" />

                        <span asp-validation-for="PhoneNumber"
                              class="validation-message"></span>

                    </div>

                </div>

            </div>

            <div class="form-section">

                <div class="form-section-title">
                    <h2>Employment Information</h2>
                    <p>Update company information.</p>
                </div>

                <div class="form-grid">

                    <div class="form-group">

                        <label asp-for="Department">
                            Department
                        </label>

                        <input asp-for="Department"
                               class="form-control" />

                        <span asp-validation-for="Department"
                              class="validation-message"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="JobTitle">
                            Job Title
                        </label>

                        <input asp-for="JobTitle"
                               class="form-control" />

                        <span asp-validation-for="JobTitle"
                              class="validation-message"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="Location">
                            Location
                        </label>

                        <input asp-for="Location"
                               class="form-control" />

                        <span asp-validation-for="Location"
                              class="validation-message"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="DateJoined">
                            Date Joined
                        </label>

                        <input asp-for="DateJoined"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="DateJoined"
                              class="validation-message"></span>

                    </div>

                </div>

            </div>

            <div class="form-section">

                <div class="form-check-row">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <div>
                        <label asp-for="IsActive">
                            Active Employee
                        </label>

                        <p>
                            Deactivate this employee if they are no longer with the company.
                        </p>
                    </div>

                </div>

            </div>

            <div class="form-actions">

                <a asp-action="Index"
                   class="nexus-btn nexus-btn-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="nexus-btn nexus-btn-primary">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}