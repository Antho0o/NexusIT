@model NexusIT.Models.MaintenanceRecord

@{
    ViewData["Title"] = "Edit Maintenance";
}

<div class="maintenance-form-page">

    <!-- HEADER -->

    <div class="maintenance-form-header">

        <a asp-action="Details"
           asp-route-id="@Model.Id"
           class="maintenance-back-link">

            ← Back to Maintenance Details

        </a>

        <span class="page-eyebrow">
            NEXUS IT / MAINTENANCE / EDIT
        </span>

        <h1>
            Edit Maintenance
        </h1>

        <p>
            Update the maintenance record and service information.
        </p>

    </div>


    <!-- FORM -->

    <div class="maintenance-form-panel">

        <div class="form-panel-header">

            <div>

                <span class="panel-eyebrow">
                    MAINTENANCE INFORMATION
                </span>

                <h2>
                    Update Details
                </h2>

                <p>
                    Modify the maintenance record below.
                </p>

            </div>

        </div>


        <form asp-action="Edit"
              method="post">

            <input type="hidden"
                   asp-for="Id" />

            <input type="hidden"
                   asp-for="CreatedDate" />


            <div asp-validation-summary="ModelOnly"
                 class="form-validation">
            </div>


            <div class="maintenance-form-grid">

                <!-- ASSET -->

                <div class="form-group form-group-full">

                    <label asp-for="AssetId">
                        Asset
                    </label>

                    <select asp-for="AssetId"
                            class="nexus-input">

                        <option value="">
                            Select an asset
                        </option>

                        @foreach (var asset in ViewBag.Assets)
                        {
                            <option value="@asset.Id">

                                @asset.AssetTag -
                                @asset.Brand
                                @asset.Model

                            </option>
                        }

                    </select>

                    <span asp-validation-for="AssetId"
                          class="field-validation">
                    </span>

                </div>


                <!-- TYPE -->

                <div class="form-group">

                    <label asp-for="MaintenanceType">
                        Maintenance Type
                    </label>

                    <select asp-for="MaintenanceType"
                            class="nexus-input">

                        <option value="Routine">
                            Routine Maintenance
                        </option>

                        <option value="Repair">
                            Repair
                        </option>

                        <option value="Inspection">
                            Inspection
                        </option>

                        <option value="Upgrade">
                            Upgrade
                        </option>

                        <option value="Replacement">
                            Replacement
                        </option>

                    </select>

                </div>


                <!-- STATUS -->

                <div class="form-group">

                    <label asp-for="Status">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="nexus-input">

                        <option value="Scheduled">
                            Scheduled
                        </option>

                        <option value="In Progress">
                            In Progress
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                    </select>

                </div>


                <!-- SCHEDULED -->

                <div class="form-group">

                    <label asp-for="ScheduledDate">
                        Scheduled Date
                    </label>

                    <input asp-for="ScheduledDate"
                           type="date"
                           class="nexus-input" />

                </div>


                <!-- COMPLETED -->

                <div class="form-group">

                    <label asp-for="CompletedDate">
                        Completed Date
                    </label>

                    <input asp-for="CompletedDate"
                           type="date"
                           class="nexus-input" />

                </div>


                <!-- TECHNICIAN -->

                <div class="form-group">

                    <label asp-for="Technician">
                        Technician
                    </label>

                    <input asp-for="Technician"
                           class="nexus-input"
                           placeholder="e.g. IT Support" />

                </div>


                <!-- COST -->

                <div class="form-group">

                    <label asp-for="Cost">
                        Maintenance Cost
                    </label>

                    <div class="cost-input">

                        <span>
                            $
                        </span>

                        <input asp-for="Cost"
                               type="number"
                               step="0.01"
                               min="0"
                               class="nexus-input"
                               placeholder="0.00" />

                    </div>

                </div>


                <!-- NOTES -->

                <div class="form-group form-group-full">

                    <label asp-for="Notes">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="nexus-input maintenance-notes"
                              placeholder="Add maintenance notes, work performed, replacement details, observations..."></textarea>

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="form-actions">

                <a asp-action="Details"
                   asp-route-id="@Model.Id"
                   class="nexus-secondary-button">

                    Cancel

                </a>

                <button type="submit"
                        class="nexus-primary-button">

                    ✓ Save Changes

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}