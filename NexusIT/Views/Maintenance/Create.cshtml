@model NexusIT.Models.MaintenanceRecord

@{
    ViewData["Title"] = "Schedule Maintenance";
}

<div class="maintenance-form-page">

    <div class="maintenance-form-header">

        <a asp-action="Index" class="back-link">
            ← Back to Maintenance
        </a>

        <span class="page-eyebrow">
            NEXUS IT / MAINTENANCE / NEW
        </span>

        <h1>
            Schedule Maintenance
        </h1>

        <p>
            Create a maintenance record for an IT asset.
        </p>

    </div>


    <div class="maintenance-form-panel">

        <div class="form-panel-header">

            <span class="panel-eyebrow">
                MAINTENANCE INFORMATION
            </span>

            <h2>
                Maintenance Details
            </h2>

        </div>


        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="form-validation">
            </div>


            <div class="maintenance-form-grid">


                <!-- ASSET -->

                <div class="form-group form-group-full">

                    <label asp-for="AssetId">
                        Asset
                    </label>

                    <select asp-for="AssetId"
                            class="nexus-input">

                        <option value="">
                            Select an asset
                        </option>

                        @foreach (var asset in ViewBag.Assets)
                        {

                            <option value="@asset.Id">

                                @asset.AssetTag -
                                @asset.Brand
                                @asset.Model

                            </option>

                        }

                    </select>

                    <span asp-validation-for="AssetId"
                          class="field-validation">
                    </span>

                </div>


                <!-- TYPE -->

                <div class="form-group">

                    <label asp-for="MaintenanceType">
                        Maintenance Type
                    </label>

                    <select asp-for="MaintenanceType"
                            class="nexus-input">

                        <option value="Routine">
                            Routine Maintenance
                        </option>

                        <option value="Repair">
                            Repair
                        </option>

                        <option value="Inspection">
                            Inspection
                        </option>

                        <option value="Upgrade">
                            Upgrade
                        </option>

                        <option value="Replacement">
                            Replacement
                        </option>

                    </select>

                    <span asp-validation-for="MaintenanceType"
                          class="field-validation">
                    </span>

                </div>


                <!-- STATUS -->

                <div class="form-group">

                    <label asp-for="Status">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="nexus-input">

                        <option value="Scheduled">
                            Scheduled
                        </option>

                        <option value="In Progress">
                            In Progress
                        </option>

                        <option value="Completed">
                            Completed
                        </option>

                    </select>

                </div>


                <!-- DATE -->

                <div class="form-group">

                    <label asp-for="ScheduledDate">
                        Scheduled Date
                    </label>

                    <input asp-for="ScheduledDate"
                           type="date"
                           class="nexus-input" />

                    <span asp-validation-for="ScheduledDate"
                          class="field-validation">
                    </span>

                </div>


                <!-- TECHNICIAN -->

                <div class="form-group">

                    <label asp-for="Technician">
                        Technician
                    </label>

                    <input asp-for="Technician"
                           class="nexus-input"
                           placeholder="e.g. IT Support" />

                </div>


                <!-- COST -->

                <div class="form-group">

                    <label asp-for="Cost">
                        Maintenance Cost
                    </label>

                    <input asp-for="Cost"
                           type="number"
                           step="0.01"
                           min="0"
                           class="nexus-input"
                           placeholder="0.00" />

                    <span asp-validation-for="Cost"
                          class="field-validation">
                    </span>

                </div>


                <!-- NOTES -->

                <div class="form-group form-group-full">

                    <label asp-for="Notes">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="nexus-input maintenance-notes"
                              placeholder="Describe the maintenance work, issue, parts replaced or other relevant information..."></textarea>

                </div>

            </div>


            <div class="form-actions">

                <a asp-action="Index"
                   class="nexus-secondary-button">

                    Cancel

                </a>

                <button type="submit"
                        class="nexus-primary-button">

                    Schedule Maintenance

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}