@model NexusIT.Models.SupportTicket

@{
    ViewData["Title"] = "Delete Ticket";
}

<div class="delete-page">

    <div class="delete-header">

        <a asp-action="Index" class="back-link">
            ← Back to Tickets
        </a>

        <span class="page-eyebrow">
            NEXUS IT / SUPPORT / DELETE
        </span>

        <h1>Delete Ticket</h1>

        <p>This action cannot be undone.</p>

    </div>


    <div class="delete-card ticket-delete-card">

        <div class="delete-icon">
            !
        </div>

        <div class="delete-content">

            <span class="panel-eyebrow">
                CONFIRM DELETION
            </span>

            <h2>
                Delete ticket #@Model.Id.ToString("D4")?
            </h2>

            <p>
                This will permanently remove the support ticket
                from the NexusIT service desk.
            </p>

        </div>


        <div class="ticket-delete-summary">

            <div class="ticket-number">
                #@Model.Id.ToString("D4")
            </div>

            <div>

                <strong>
                    @Model.Title
                </strong>

                <span>
                    @Model.Category · @Model.Priority Priority
                </span>

            </div>

        </div>


        <div class="delete-details">

            <div>
                <span>STATUS</span>
                <strong>@Model.Status</strong>
            </div>

            <div>
                <span>EMPLOYEE</span>

                <strong>
                    @if (Model.Employee != null)
                    {
                        @Model.Employee.FirstName @Model.Employee.LastName
                    }
                    else
                    {
                        <text>Unassigned</text>
                    }
                </strong>
            </div>

            <div>
                <span>ASSET</span>

                <strong>
                    @(Model.Asset?.AssetTag ?? "None")
                </strong>
            </div>

        </div>


        <form asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            <div class="delete-actions">

                <a asp-action="Index"
                   class="nexus-secondary-button">
                    Cancel
                </a>

                <button type="submit"
                        class="nexus-danger-button">
                    Delete Ticket
                </button>

            </div>

        </form>

    </div>

</div>